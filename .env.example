# HMK UNSA - GDrive Sheets DB (dari 0)
# Copy ke .env.local dan isi. Jangan commit .env.local

# 1. Folder GDrive kamu (sudah ada) -> https://drive.google.com/drive/folders/1QdC9LJ_j7GTLKR8TbT4cXLuWXjeJ-QX9
GOOGLE_DRIVE_FOLDER_ID=1QdC9LJ_j7GTLKR8TbT4cXLuWXjeJ-QX9
# Judul spreadsheet yang akan dibuat di folder itu (default HMSK-Presensi-DB)
GOOGLE_SHEET_TITLE=HMSK-Presensi-DB

# 2. ID spreadsheet dari URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# (akan auto-isi setelah npx tsx scripts/create-sheet-in-folder.ts)
GOOGLE_SHEET_ID=1AbCxxxxxxxxxx

# 3. Service Account JSON (full). Bisa paste JSON string atau base64(JSON)
# Buat di: https://console.cloud.google.com -> IAM -> Service Accounts -> Create -> Keys -> JSON
# Share FOLDER https://drive.google.com/drive/folders/1QdC9LJ_j7GTLKR8TbT4cXLuWXjeJ-QX9 ke client_email sebagai Editor (bukan hanya Anyone with link)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"hmsk-presensi@xxx.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# 3. CARA SEDERHANA (tanpa Service Account) - cukup 2 klik:
# Buka spreadsheet https://docs.google.com/spreadsheets/d/1XtVR4WImdUc8rr0Qxqho9Br9dzSRiPIOFaKclMAKVEI/edit
# → Extensions → Apps Script → paste isi scripts/apps-script.gs → Deploy → Web app → Anyone
# → copy URL → paste di bawah:
# APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec

# 4. Cache TTL detik (opsional, default 30)
GOOGLE_SHEET_CACHE_TTL=30

# 4. Admin PIN untuk /admin (sudah ada, contoh)
# ADMIN_PIN=admin123

# Fallback: jika GOOGLE_SHEET_ID kosong, app otomatis pakai data/*.json (dev offline) jadi tetap bisa npm run dev tanpa Google
